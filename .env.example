# 复制为本文件同目录下的 .env，并放在打包后的二进制文件旁边。
# 含特殊字符的值请用双引号包裹。
# 使用 Compose 时，主机名写 mysql，账号、密码、库名与 MYSQL_USER、MYSQL_PASSWORD、MYSQL_DATABASE 相同。
# 形式：用户名:密码@tcp(mysql:3306)/库名?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PREFIX=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
CREDENTIAL_KEY=
HTTP_ADDR=:8080
